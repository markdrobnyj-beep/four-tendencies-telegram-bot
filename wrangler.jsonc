{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "four-tendencies-telegram-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "four-tendencies-bot",
      "database_id": "547385f4-00d1-4694-b97b-3a7a556e0742",
      "migrations_dir": "migrations"
    }
  ]
}
